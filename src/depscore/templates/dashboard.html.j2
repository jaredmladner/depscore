<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>depscore – SBOM Dependency Score Report</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0f172a; --surface: #1e293b; --surface2: #293548;
      --border: #334155; --text: #e2e8f0; --muted: #94a3b8;
      --green: #22c55e; --lime: #84cc16; --yellow: #eab308;
      --orange: #f97316; --red: #ef4444; --blue: #3b82f6;
      --accent: #6366f1;
    }
    body { background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; font-size: 14px; }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }

    /* Layout */
    header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; }
    header h1 { font-size: 20px; font-weight: 700; }
    header .meta { color: var(--muted); font-size: 12px; }
    main { max-width: 1400px; margin: 0 auto; padding: 24px; }

    /* Cards */
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
    .card h3 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 8px; }
    .card .value { font-size: 36px; font-weight: 800; }
    .card .sub { font-size: 12px; color: var(--muted); margin-top: 4px; }

    /* Charts row */
    .charts { display: grid; grid-template-columns: 240px 1fr 320px; gap: 16px; margin-bottom: 24px; }
    .chart-box { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 20px; }
    .chart-box h3 { font-size: 13px; font-weight: 600; margin-bottom: 16px; }
    canvas { max-height: 220px; }

    /* Grade badge */
    .grade { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: 700; font-size: 13px; color: #fff; }
    .grade-A { background: var(--green); }
    .grade-B { background: var(--lime); color: #111; }
    .grade-C { background: var(--yellow); color: #111; }
    .grade-D { background: var(--orange); }
    .grade-F { background: var(--red); }

    /* Score bar */
    .score-bar { display: flex; align-items: center; gap: 8px; }
    .score-bar .bar { flex: 1; height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
    .score-bar .fill { height: 100%; border-radius: 3px; }
    .score-bar .num { width: 36px; text-align: right; font-size: 12px; font-weight: 600; }

    /* Table */
    .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
    .table-controls { padding: 12px 16px; display: flex; gap: 12px; align-items: center; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
    .table-controls input, .table-controls select {
      background: var(--surface2); border: 1px solid var(--border); color: var(--text);
      border-radius: 6px; padding: 6px 10px; font-size: 13px;
    }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: var(--surface2); padding: 10px 12px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); cursor: pointer; user-select: none; white-space: nowrap; }
    thead th:hover { color: var(--text); }
    tbody tr { border-top: 1px solid var(--border); cursor: pointer; transition: background 0.1s; }
    tbody tr:hover { background: var(--surface2); }
    td { padding: 10px 12px; vertical-align: middle; }
    .pkg-name { font-weight: 600; }
    .pkg-version { color: var(--muted); font-size: 12px; }
    .ecosystem-badge { display: inline-block; padding: 1px 8px; background: var(--surface2); border: 1px solid var(--border); border-radius: 4px; font-size: 11px; color: var(--muted); }

    /* Detail panel */
    .detail-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 100; }
    .detail-overlay.open { display: flex; align-items: flex-start; justify-content: flex-end; }
    .detail-panel { background: var(--surface); width: min(640px, 100vw); height: 100vh; overflow-y: auto; padding: 24px; border-left: 1px solid var(--border); }
    .detail-panel h2 { font-size: 18px; margin-bottom: 4px; }
    .detail-panel .close-btn { float: right; background: none; border: none; color: var(--muted); font-size: 20px; cursor: pointer; }
    .dim-section { margin-top: 20px; }
    .dim-section h4 { font-size: 12px; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
    .dim-row { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
    .dim-label { width: 130px; font-size: 13px; }
    .reasoning { font-size: 12px; color: var(--muted); margin-top: 4px; line-height: 1.5; }
    .signals-table { width: 100%; font-size: 12px; margin-top: 8px; }
    .signals-table td { padding: 3px 6px; border-top: 1px solid var(--border); }
    .signals-table td:first-child { color: var(--muted); width: 55%; }
    .cve-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .cve-chip { background: var(--surface2); border: 1px solid var(--red); color: var(--red); padding: 2px 8px; border-radius: 4px; font-size: 11px; font-family: monospace; }

    /* Responsive */
    @media (max-width: 900px) {
      .charts { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<script>window.__DEPSCORE__ = {{ report_json | safe }};</script>

<header>
  <div>
    <h1>depscore</h1>
    <div class="meta">Generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M UTC') }} · v{{ report.depscore_version }}</div>
  </div>
  <div style="text-align:right">
    <div style="font-size:12px;color:var(--muted)">Overall SBOM Score</div>
    <div style="font-size:28px;font-weight:800;">{{ "%.1f"|format(report.overall_sbom_score) }}
      <span class="grade grade-{{ report.overall_sbom_grade }}">{{ report.overall_sbom_grade }}</span>
    </div>
  </div>
</header>

<main>
  <!-- Summary cards -->
  <div class="cards">
    <div class="card">
      <h3>Dependencies</h3>
      <div class="value">{{ report.total_dependencies }}</div>
      <div class="sub">scanned in this SBOM</div>
    </div>
    {% for grade, color in grade_colors.items() %}
    <div class="card" style="border-top: 3px solid {{ color }}">
      <h3>Grade {{ grade }}</h3>
      <div class="value" style="color:{{ color }}">{{ report.grade_distribution.get(grade, 0) }}</div>
      <div class="sub">{{ "%.0f"|format((report.grade_distribution.get(grade, 0) / report.total_dependencies * 100) if report.total_dependencies else 0) }}% of dependencies</div>
    </div>
    {% endfor %}
  </div>

  <!-- Charts -->
  <div class="charts">
    <div class="chart-box">
      <h3>Grade Distribution</h3>
      <canvas id="gradeChart"></canvas>
    </div>
    <div class="chart-box">
      <h3>Dimension Averages</h3>
      <canvas id="radarChart"></canvas>
    </div>
    <div class="chart-box">
      <h3>Score Distribution</h3>
      <canvas id="histChart"></canvas>
    </div>
  </div>

  <!-- Dependency table -->
  <div class="table-wrap">
    <div class="table-controls">
      <input type="text" id="searchInput" placeholder="Search dependencies…" style="width:220px" />
      <select id="ecoFilter"><option value="">All ecosystems</option></select>
      <select id="gradeFilter"><option value="">All grades</option>
        {% for g in ['A','B','C','D','F'] %}<option value="{{ g }}">Grade {{ g }}</option>{% endfor %}
      </select>
      <span id="rowCount" style="color:var(--muted);font-size:12px;margin-left:auto"></span>
    </div>
    <table id="depsTable">
      <thead>
        <tr>
          <th data-col="dependency_name">Package ↕</th>
          <th data-col="ecosystem">Ecosystem ↕</th>
          <th data-col="overall" style="width:90px">Score ↕</th>
          <th data-col="maturity_score" style="width:110px">Maturity</th>
          <th data-col="maintainability_score" style="width:110px">Maintain.</th>
          <th data-col="security_score" style="width:110px">Security</th>
          <th data-col="community_score" style="width:110px">Community</th>
          <th data-col="overall_grade" style="width:70px">Grade ↕</th>
          <th data-col="cve_count" style="width:60px">CVEs</th>
        </tr>
      </thead>
      <tbody id="depsBody"></tbody>
    </table>
  </div>
</main>

<!-- Detail panel -->
<div class="detail-overlay" id="detailOverlay">
  <div class="detail-panel" id="detailPanel">
    <button class="close-btn" onclick="closeDetail()">✕</button>
    <div id="detailContent"></div>
  </div>
</div>

<script>
const DATA = window.__DEPSCORE__;
const scores = DATA.scores;

// --- Populate ecosystem filter ---
const ecosystems = [...new Set(scores.map(s => s.ecosystem).filter(Boolean))].sort();
const ecoFilter = document.getElementById('ecoFilter');
ecosystems.forEach(e => {
  const opt = document.createElement('option');
  opt.value = e; opt.textContent = e;
  ecoFilter.appendChild(opt);
});

// --- Charts ---
const GRADE_COLORS = { A: '#22c55e', B: '#84cc16', C: '#eab308', D: '#f97316', F: '#ef4444' };
const DIM_COLORS = ['#6366f1','#3b82f6','#22c55e','#f97316'];

// Grade donut
new Chart(document.getElementById('gradeChart'), {
  type: 'doughnut',
  data: {
    labels: Object.keys(DATA.grade_distribution),
    datasets: [{
      data: Object.values(DATA.grade_distribution),
      backgroundColor: Object.keys(DATA.grade_distribution).map(g => GRADE_COLORS[g] || '#94a3b8'),
      borderWidth: 2, borderColor: '#1e293b'
    }]
  },
  options: { plugins: { legend: { labels: { color: '#e2e8f0', font: { size: 12 } } } }, cutout: '60%' }
});

// Radar
const dimLabels = ['Maturity', 'Maintainability', 'Security', 'Community'];
const dimKeys = ['maturity', 'maintainability', 'security_posture', 'community_health'];
new Chart(document.getElementById('radarChart'), {
  type: 'radar',
  data: {
    labels: dimLabels,
    datasets: [{
      label: 'Average',
      data: dimKeys.map(k => DATA.dimension_averages[k] || 0),
      backgroundColor: 'rgba(99,102,241,0.2)',
      borderColor: '#6366f1',
      pointBackgroundColor: '#6366f1'
    }]
  },
  options: {
    scales: { r: { min: 0, max: 100, grid: { color: '#334155' }, ticks: { color: '#94a3b8', stepSize: 20 }, pointLabels: { color: '#e2e8f0', font: { size: 11 } } } },
    plugins: { legend: { display: false } }
  }
});

// Histogram
const buckets = Array(10).fill(0);
scores.forEach(s => { const b = Math.min(9, Math.floor(s.overall / 10)); buckets[b]++; });
new Chart(document.getElementById('histChart'), {
  type: 'bar',
  data: {
    labels: ['0-9','10-19','20-29','30-39','40-49','50-59','60-69','70-79','80-89','90-100'],
    datasets: [{ data: buckets, backgroundColor: '#6366f1', borderRadius: 4 }]
  },
  options: { plugins: { legend: { display: false } }, scales: { x: { ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { color: '#334155' } }, y: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } } } }
});

// --- Table rendering ---
function scoreBar(score, color) {
  return `<div class="score-bar">
    <div class="bar"><div class="fill" style="width:${score}%;background:${color}"></div></div>
    <div class="num">${score.toFixed(0)}</div>
  </div>`;
}

function dimColor(score) {
  if (score >= 80) return '#22c55e';
  if (score >= 65) return '#84cc16';
  if (score >= 50) return '#eab308';
  if (score >= 35) return '#f97316';
  return '#ef4444';
}

let sortCol = 'overall', sortDir = -1;
let filtered = [...scores];

function renderTable() {
  const search = document.getElementById('searchInput').value.toLowerCase();
  const eco = ecoFilter.value;
  const grade = document.getElementById('gradeFilter').value;

  filtered = scores.filter(s => {
    if (search && !s.dependency_name.toLowerCase().includes(search)) return false;
    if (eco && s.ecosystem !== eco) return false;
    if (grade && s.overall_grade !== grade) return false;
    return true;
  });

  filtered.sort((a, b) => {
    let av = a[sortCol] ?? 0, bv = b[sortCol] ?? 0;
    if (sortCol === 'maturity_score') { av = a.maturity.score; bv = b.maturity.score; }
    if (sortCol === 'maintainability_score') { av = a.maintainability.score; bv = b.maintainability.score; }
    if (sortCol === 'security_score') { av = a.security_posture.score; bv = b.security_posture.score; }
    if (sortCol === 'community_score') { av = a.community_health.score; bv = b.community_health.score; }
    if (sortCol === 'cve_count') { av = a.security_posture?.signals?.vuln_count_total ?? 0; bv = b.security_posture?.signals?.vuln_count_total ?? 0; }
    if (typeof av === 'string') return sortDir * av.localeCompare(bv);
    return sortDir * (av - bv);
  });

  const tbody = document.getElementById('depsBody');
  tbody.innerHTML = filtered.map((s, i) => {
    const cveCount = (s.osv_vuln_total ?? 0);
    return `<tr onclick="showDetail(${scores.indexOf(s)})">
      <td><div class="pkg-name">${s.dependency_name}</div><div class="pkg-version">${s.version || ''}</div></td>
      <td><span class="ecosystem-badge">${s.ecosystem || '?'}</span></td>
      <td><strong>${s.overall.toFixed(1)}</strong></td>
      <td>${scoreBar(s.maturity.score, dimColor(s.maturity.score))}</td>
      <td>${scoreBar(s.maintainability.score, dimColor(s.maintainability.score))}</td>
      <td>${scoreBar(s.security_posture.score, dimColor(s.security_posture.score))}</td>
      <td>${scoreBar(s.community_health.score, dimColor(s.community_health.score))}</td>
      <td><span class="grade grade-${s.overall_grade}">${s.overall_grade}</span></td>
      <td style="color:${cveCount > 0 ? 'var(--red)' : 'var(--muted)'}">${cveCount || 0}</td>
    </tr>`;
  }).join('');

  document.getElementById('rowCount').textContent = `${filtered.length} / ${scores.length} packages`;
}

// Sort on header click
document.querySelectorAll('thead th[data-col]').forEach(th => {
  th.addEventListener('click', () => {
    const col = th.dataset.col;
    if (sortCol === col) sortDir *= -1; else { sortCol = col; sortDir = -1; }
    renderTable();
  });
});

['searchInput','ecoFilter','gradeFilter'].forEach(id =>
  document.getElementById(id).addEventListener('input', renderTable)
);

renderTable();

// --- Detail panel ---
function showDetail(idx) {
  const s = scores[idx];
  const dims = [
    { key: 'maturity', label: 'Maturity' },
    { key: 'maintainability', label: 'Maintainability' },
    { key: 'security_posture', label: 'Security Posture' },
    { key: 'community_health', label: 'Community Health' },
  ];

  let cveHtml = '';
  const cves = s.security_posture?.signals?.cve_ids || [];
  if (cves.length) {
    cveHtml = `<div class="dim-section"><h4>CVE IDs</h4><div class="cve-list">${cves.map(c => `<span class="cve-chip">${c}</span>`).join('')}</div></div>`;
  }

  let signalsHtml = '';
  const allSignals = {};
  dims.forEach(d => Object.assign(allSignals, s[d.key]?.signals || {}));
  const sigEntries = Object.entries(allSignals).filter(([,v]) => v !== null && v !== undefined);
  if (sigEntries.length) {
    signalsHtml = `<div class="dim-section"><h4>Raw Signals</h4>
      <table class="signals-table">${sigEntries.map(([k,v]) =>
        `<tr><td>${k.replace(/_/g,' ')}</td><td>${typeof v === 'number' ? v.toFixed ? v.toFixed(2) : v : v}</td></tr>`
      ).join('')}</table></div>`;
  }

  document.getElementById('detailContent').innerHTML = `
    <h2>${s.dependency_name}</h2>
    <div style="color:var(--muted);font-size:12px;margin-bottom:12px">${s.purl || s.ecosystem || ''} · v${s.version || 'unknown'}</div>
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <div style="font-size:40px;font-weight:800">${s.overall.toFixed(1)}</div>
      <span class="grade grade-${s.overall_grade}" style="font-size:18px;padding:4px 14px">${s.overall_grade}</span>
    </div>
    <div class="dim-section">
      <h4>Scores by Dimension</h4>
      ${dims.map(d => {
        const dim = s[d.key];
        const color = dimColor(dim.score);
        return `<div style="margin-bottom:12px">
          <div class="dim-row">
            <div class="dim-label">${d.label}</div>
            ${scoreBar(dim.score, color)}
            <div style="font-size:11px;color:var(--muted)">${(dim.confidence*100).toFixed(0)}% conf.</div>
          </div>
          <div class="reasoning">${dim.reasoning}</div>
        </div>`;
      }).join('')}
    </div>
    ${cveHtml}
    ${signalsHtml}
    ${s.ai_available === false ? `<div style="margin-top:12px;font-size:12px;color:var(--orange)">⚠ AI scoring unavailable: ${s.ai_error || 'unknown error'}</div>` : ''}
  `;

  document.getElementById('detailOverlay').classList.add('open');
}

function closeDetail() {
  document.getElementById('detailOverlay').classList.remove('open');
}

document.getElementById('detailOverlay').addEventListener('click', e => {
  if (e.target === document.getElementById('detailOverlay')) closeDetail();
});
</script>
</body>
</html>
